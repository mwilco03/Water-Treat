# Water-Treat RTU Environment Configuration
# ============================================================================
#
# This file defines environment variables for the Water-Treat RTU service.
# It is loaded by systemd when the service starts.
#
# Reload after changes:
#   sudo systemctl daemon-reload && sudo systemctl restart water-treat
#
# Port Allocation Scheme:
#   8xxx = Controller plane (Water-Controller on SBC #1)
#   9xxx = RTU plane (Water-Treat on SBC #2)
#
# See: docs/decisions/DR-001-port-allocation.md for full rationale.
# ============================================================================

# HTTP Server Port
# ----------------
# The HTTP server provides health check endpoints (/health, /metrics, /ready, /live)
# Valid range: 1-65535
# Default: 9081
#
WT_HTTP_PORT=9081

# Headless Mode
# -------------
# Force headless (daemon) mode even when config has daemon_mode=false.
# This prevents ncurses TUI initialization which would crash without a terminal.
#
# Auto-detection also triggers headless mode when:
#   - TERM is unset or "dumb"
#   - stdin is not a TTY (running under systemd, cron, Docker, etc.)
#
# Values: 1, true, yes (case-insensitive) to enable
# Default: unset (auto-detect based on terminal availability)
#
# WT_HEADLESS=1

# Terminal Type (safety fallback)
# -------------------------------
# Setting TERM=dumb ensures headless mode is triggered even if auto-detection
# fails. This is set in the systemd service file as a safety measure.
#
# TERM=dumb

# Future Configuration Options
# ----------------------------
# Additional environment variables can be added following the same pattern:
#
# WT_LOG_LEVEL=INFO         # Log verbosity: TRACE, DEBUG, INFO, WARNING, ERROR
# WT_INTERFACE=eth0         # Network interface for PROFINET (auto-detected if unset)
# WT_CYCLE_TIME=32          # PROFINET minimum device interval (ms)
